# true = roda o navegador invisivel (producao) / false = mostra o navegador (para acompanhar/depurar)
DF_HEADLESS=false

# Pausa entre cada nota lancada, em milissegundos (evita bater no site muito rapido)
DF_DELAY_MS=3000

# Quantas notas processar por sessao de navegador antes de fechar e reabrir o
# Chromium (evita a memoria RAM crescer sem limite num lote longo -- ver
# comentario em src/config.js)
DF_TAMANHO_LOTE=10
