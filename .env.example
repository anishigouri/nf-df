# true = roda o navegador invisivel (producao) / false = mostra o navegador (para acompanhar/depurar)
DF_HEADLESS=false

# Pausa entre cada nota lancada, em milissegundos (evita bater no site muito rapido)
DF_DELAY_MS=3000

# Quantas notas processar por sessao de navegador antes de fechar e reabrir o
# Chromium (evita a memoria RAM crescer sem limite num lote longo -- ver
# comentario em src/config.js). 1 = mais lento (relogin a cada nota) mas mais
# seguro pro plano free/starter do Render (512MB de RAM)
DF_TAMANHO_LOTE=1

# Opcional, so pra consulta manual (logs/deploys/metricas do Render) -- nenhum
# codigo do app le essa variavel. Gere em Render -> Account Settings -> API
# Keys. E uma credencial de conta inteira, mais sensivel que as outras deste
# arquivo -- NUNCA comite o valor real (esse arquivo .env.example vai pro
# git; o valor de verdade so deve existir no seu .env local, que e ignorado).
RENDER_API_KEY=

# development (padrao se nao definido) ou production -- ver comentario em
# src/config.js sobre o que muda em cada modo. O Dockerfile ja fixa
# production pra qualquer deploy real (Render inclusive); so precisa setar
# aqui se for simular producao rodando localmente sem Docker.
NODE_ENV=development