# Credenciais de acesso ao ISS Online DF (https://iss.fazenda.df.gov.br/online)
DF_LOGIN=
DF_SENHA=

# Caminho da planilha de notas a lancar
DF_PLANILHA_PATH=./planilhas/notas.xlsx

# true = roda o navegador invisivel (producao) / false = mostra o navegador (para acompanhar/depurar)
DF_HEADLESS=false

# Pausa entre cada nota lancada, em milissegundos (evita bater no site muito rapido)
DF_DELAY_MS=3000
