# CNPJ do estabelecimento a selecionar apos o login
DF_CNPJ_ESTABELECIMENTO=40.432.544/0758-21

# Esse pacote usa a versao "headless-shell" do Chromium (mais leve, ~272MB
# em vez de ~428MB) pra caber menos no disco -- essa versao NUNCA abre
# janela visivel, entao DF_HEADLESS fica sempre true na pratica.
DF_HEADLESS=true
DF_CHROMIUM_HEADLESS_SHELL=true

# Pausa entre cada nota lancada, em milissegundos (evita bater no site muito rapido)
DF_DELAY_MS=5000

# Quantas notas processar por sessao de navegador antes de fechar e reabrir o
# Chromium. Um PC normal tem RAM de sobra (isso so importava no servidor
# gratuito do Render, com 512MB) -- pode deixar bem mais alto que la.
DF_TAMANHO_LOTE=20
